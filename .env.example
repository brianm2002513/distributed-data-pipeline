# Adzuna API credentials - create free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Jooble API key - https://jooble.org/api-about
# (Optional: the browser-based Jooble scraper works without it.)
JOOBLE_API_KEY=your_api_key_here

# Optional: override the data directory (used by the test suite)
# DATA_DIR=./data